# ============================================================================
#  Big-D-Agent — environment template
#  Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================================

# ----- Telegram (required) -----
# TELEGRAM_BOT_TOKEN: from @BotFather
# TELEGRAM_ADMIN_ID:  your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=0

# ----- OpenRouter (required for AI replies) -----
# OPENROUTER_API_KEY: from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# Model tiers — override to taste. See src/llm/openrouter.py for defaults.
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_QUALITY=anthropic/claude-3.5-sonnet
OPENROUTER_APP_URL=https://github.com/dream30915/big-d-agent
OPENROUTER_APP_NAME=Big-D-Agent

# ----- Database (Postgres) -----
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/big_d_agent
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=big_d_agent

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- API server -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- n8n (optional automation) -----
N8N_WEBHOOK_URL=
N8N_API_KEY=

# ----- Bot config -----
ENVIRONMENT=production
LOG_LEVEL=INFO
BOT_MAX_WORKERS=5

# ----- Cost guard / limits -----
# Daily caps enforced across all users (whichever trips first). Reset each UTC day.
DAILY_TOKEN_BUDGET=200000
DAILY_COST_BUDGET_USD=5.0
# Per-user requests/minute.
USER_RATE_PER_MIN=20
# How many recent (user, assistant) turns to keep as conversation memory.
MEMORY_TURNS=6

# ----- Scheduler -----
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=UTC
MAX_SCHEDULES_PER_USER=10

# ----- Feature flags -----
ENABLE_MULTI_AGENT=false
ENABLE_MARKETPLACE=false
ENABLE_SELF_OPTIMIZATION=false
ENABLE_ETHICS_MODULE=true

# ----- Payments (NOT implemented yet — placeholders for a future PR) -----
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
